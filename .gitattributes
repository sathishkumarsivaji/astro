# Ensure LF line endings on all text files across all platforms
* text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Release integrity: exclude release artifacts and detached attestations from distribution archives
RELEASE_ATTESTATION.json export-ignore
RELEASE_ATTESTATION.sha256 export-ignore
ASTRO.zip export-ignore
ASTRO*.zip export-ignore
ENVIRONMENT_PREPARATION_LOG.json export-ignore

